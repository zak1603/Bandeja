# Copy to .env and fill in. Never commit .env.

# --- Frontend (public; shipped to the browser, protected by RLS) ---
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server only (api/notify.ts). Never prefix with VITE_ ---
RESEND_API_KEY=re_your_resend_api_key
ADMIN_NOTIFICATION_EMAIL=admin@bandejapadel.com
# Optional. Defaults to onboarding@resend.dev, which only delivers to your own Resend account email.
RESEND_FROM_EMAIL="Bandeja Padel <bookings@yourdomain.com>"
CLUB_NAME="Bandeja Padel Club"
CLUB_ADDRESS="123 Example Street, Your City"
